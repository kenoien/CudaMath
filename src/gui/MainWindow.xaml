<Window
    x:Class="CudaMathGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <MenuBar>
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New Workspace" Click="NewWorkspaceClick"/>
                <MenuFlyoutItem Text="Open Workspace" Click="OpenWorkspaceClick"/>
                <MenuFlyoutItem Text="Save Workspace" Click="SaveWorkspaceClick"/>
                <MenuFlyoutItem Text="Open Script" Click="OpenScriptClick"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="ExitClick"/>
            </MenuBarItem>
            <MenuBarItem x:Name="WindowMenu" Title="Window"/>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Help" Click="HelpClick"/>
                <MenuFlyoutItem Text="About" Click="AboutClick"/>
            </MenuBarItem>
        </MenuBar>
        <Canvas x:Name="MdiClient" Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
        <Border Grid.Row="2" Height="32"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0" Padding="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="CUDA free memory" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="CudaFreeStatus" Text="0.0 MB" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="12,0,16,0">
                    <TextBlock x:Name="CudaStatus" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
