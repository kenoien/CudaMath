    expect(sinh(single(0)), single(0))
    expect(sinh(zeros(1, 3, 'single')), zeros(1, 3, 'single'))
    expect(sinh(zeros(3, 1, 'single')), zeros(3, 1, 'single'))
    expect(sinh(zeros(2, 'single')), zeros(2, 'single'))
