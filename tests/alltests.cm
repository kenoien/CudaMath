tests 'all'

% Construction and shape. zeros, ones, eye, size, numel, length, ndims, isempty, diag, linspace, repmat, tril, triu, horzcat, and vertcat.

  test 'zeros and eye'
    expect(zeros(2), [0 0; 0 0])
    expect(eye(2), [1 0; 0 1])
    expect(size(eye(3)), [3 3])
  end

  test 'construction'
    expect(class(zeros(2, 3)), 'double')
    expect(class(zeros(2, 3, 'single')), 'single')
    expect(class(zeros(2, 3, 'int32')), 'int32')
    expect(class(zeros(2, 3, 'int64')), 'int64')
    expect(class(ones(2, 'double')), 'double')
    expect(class(ones(2, 'single')), 'single')
    expect(class(ones(2, 'int32')), 'int32')
    expect(class(ones(2, 'int64')), 'int64')
    expect(class(eye(2)), 'double')
    expect(class(eye(2, 'single')), 'single')
    expect(class(eye(2, 'int32')), 'int32')
    expect(class(eye(2, 'int64')), 'int64')
    expect(sum(zeros(2, 3), 'all'), 0)
    expect(sum(zeros(2, 3, 'single'), 'all'), 0)
    expect(sum(zeros(2, 3, 'int32'), 'all'), int32(0))
    expect(sum(zeros(2, 3, 'int64'), 'all'), int64(0))
    expect(sum(ones(2, 2), 'all'), 4)
    expect(sum(ones(2, 2, 'single'), 'all'), 4)
    expect(sum(ones(2, 2, 'int32'), 'all'), int32(4))
    expect(sum(ones(2, 2, 'int64'), 'all'), int64(4))
    expect(eye(2), [1 0; 0 1])
    expect(eye(2, 'single'), single([1 0; 0 1]))
    expect(eye(2, 'int32'), int32([1 0; 0 1]))
    expect(eye(2, 'int64'), int64([1 0; 0 1]))
    expect(size(zeros(2, 5, 'int32')), [2 5])
    expect(size(ones(2, 5, 'single'), 1), 2)
    expect(size(ones(2, 5, 'int64'), 2), 5)
    expect(numel(eye(3, 'int32')), 9)
    expect(length(zeros(2, 5, 'single')), 5)
    expect(ndims(ones(1, 'int64')), 2)
    expect(isempty(zeros(0, 1)), 1)
    expect(isempty(zeros(0, 1, 'single')), 1)
    expect(isempty(zeros(0, 1, 'int32')), 1)
    expect(isempty(zeros(0, 1, 'int64')), 1)
    expect(isempty(ones(1)), 0)
    expect(isempty(ones(1, 'single')), 0)
    expect(isempty(ones(1, 'int32')), 0)
    expect(isempty(ones(1, 'int64')), 0)
  end

  test 'shape'
    expect(diag([1 2 3]), [1 0 0; 0 2 0; 0 0 3])
    expect(diag([1 2; 3 4]), [1; 4])
    expect(linspace(0, 1, 3), [0 0.5 1])
    expect(repmat([1 2], 2, 1), [1 2; 1 2])
    expect(tril([1 2; 3 4]), [1 0; 3 4])
    expect(triu([1 2; 3 4]), [1 2; 0 4])
    expect(horzcat([1; 2], [3; 4]), [1 3; 2 4])
    expect(vertcat([1 2], [3 4]), [1 2; 3 4])
  end


% Arithmetic. Addition, subtraction, elementwise and matrix multiplication, and division for double, single, int32, and int64, including a scalar combined with a row, a column, and a matrix.

  test 'double arithmetic'
    a = [1 2; 3 4]
    expect(class(a), 'double')
    expect(a + a, [2 4; 6 8])
    expect(a - 1, [0 1; 2 3])
    expect(a .* 2, [2 4; 6 8])
    expect(2 * a, [2 4; 6 8])
    expect(a * 2, [2 4; 6 8])
    expect(2 * [1 2 3], [2 4 6])
    expect(2 * [1; 2; 3], [2; 4; 6])
    expect([1 2 3] * 2, [2 4 6])
    expect(a ./ 2, [0.5 1; 1.5 2])
    expect(a * eye(2), a)
    expect(a', [1 3; 2 4])
    expect(-a, [-1, -2; -3, -4])
    expect(abs(a), a)
    expect(abs([-2 3]), [2 3])
    expect(sqrt([4 9]), [2 3])
    expect(sum(a, 'all'), 10)
    expect(reshape(a, 4, 1), [1; 3; 2; 4])
    expect(a == a, ones(2))
    expect(a ~= a, zeros(2))
    expect(a > 2, [0 0; 1 1])
    expect(a >= 2, [0 1; 1 1])
    expect(a < 2, [1 0; 0 0])
    expect(a <= 2, [1 1; 0 0])
    expect(class(single(a)), 'single')
    expect(class(int32(a)), 'int32')
    expect(class(int64(a)), 'int64')
    expect(double(single(a)), a)
  end

  test 'single arithmetic'
    a = single([1 2; 3 4])
    expect(class(a), 'single')
    expect(a + a, single([2 4; 6 8]))
    expect(a - single(1), single([0 1; 2 3]))
    expect(a .* single(2), single([2 4; 6 8]))
    expect(single(2) * a, single([2 4; 6 8]))
    expect(a * single(2), single([2 4; 6 8]))
    expect(2 * a, [2 4; 6 8])
    expect(a ./ single(2), [0.5 1; 1.5 2])
    expect(a * eye(2, 'single'), a)
    expect(a', single([1 3; 2 4]))
    expect(-a, single([-1, -2; -3, -4]))
    expect(abs(a), [1 2; 3 4])
    expect(sqrt(single([4 9])), [2 3])
    expect(sum(a, 'all'), 10)
    expect(reshape(a, 1, 4), single([1 3 2 4]))
    expect(a == a, ones(2))
    expect(a ~= a, zeros(2))
    expect(class(double(a)), 'double')
    expect(class(int32(a)), 'int32')
    expect(class(int64(a)), 'int64')
    expect(single(double(a)), a)
  end

  test 'int32 arithmetic'
    a = int32([1 2; 3 4])
    expect(class(a), 'int32')
    expect(a + a, int32([2 4; 6 8]))
    expect(a - int32(1), int32([0 1; 2 3]))
    expect(a .* int32(2), int32([2 4; 6 8]))
    expect(int32(2) * a, [2 4; 6 8])
    expect(a * int32(2), [2 4; 6 8])
    expect(a ./ int32(2), [0.5 1; 1.5 2])
    expect(a * a, [7 10; 15 22])
    expect(a', int32([1 3; 2 4]))
    expect(-a, int32([-1, -2; -3, -4]))
    expect(abs(int32([-2 3])), int32([2 3]))
    expect(sqrt(int32([4 9])), [2 3])
    expect(sum(a, 'all'), int32(10))
    expect(reshape(a, 4, 1), int32([1; 3; 2; 4]))
    expect(a == a, ones(2))
    expect(a ~= a, zeros(2))
    expect(a > int32(2), [0 0; 1 1])
    expect(class(double(a)), 'double')
    expect(class(single(a)), 'single')
    expect(class(int64(a)), 'int64')
    expect(int32(double(a)), a)
  end

  test 'int64 arithmetic'
    a = int64([1 2; 3 4])
    expect(class(a), 'int64')
    expect(a + a, int64([2 4; 6 8]))
    expect(a - int64(1), int64([0 1; 2 3]))
    expect(a .* int64(2), int64([2 4; 6 8]))
    expect(int64(2) * a, [2 4; 6 8])
    expect(a * int64(2), [2 4; 6 8])
    expect(a ./ int64(2), [0.5 1; 1.5 2])
    expect(a * a, [7 10; 15 22])
    expect(a', int64([1 3; 2 4]))
    expect(-int64(3), int64(-3))
    expect(abs(int64([-2 3])), int64([2 3]))
    expect(sqrt(int64([4 9])), [2 3])
    expect(sum(a, 'all'), int64(10))
    expect(reshape(a, 4, 1), int64([1; 3; 2; 4]))
    expect(a == a, ones(2))
    expect(a < int64(3), [1 1; 0 0])
    expect(class(double(a)), 'double')
    expect(class(single(a)), 'single')
    expect(class(int32(a)), 'int32')
    expect(int64(int32(a)), a)
  end

  test 'scalar arithmetic'
    a = [1 2; 3 4]
    row = [1 2 3]
    col = [1; 2; 3]
    expect(2 * a, [2 4; 6 8])
    expect(a * 2, [2 4; 6 8])
    expect(2 * row, [2 4 6])
    expect(row * 2, [2 4 6])
    expect(2 * col, [2; 4; 6])
    expect(col * 2, [2; 4; 6])
    expect(1 + a, [2 3; 4 5])
    expect(a + 1, [2 3; 4 5])
    expect(1 + row, [2 3 4])
    expect(row + 1, [2 3 4])
    expect(1 + col, [2; 3; 4])
    expect(col + 1, [2; 3; 4])
    expect(1 - a, [0, -1; -2, -3])
    expect(a - 1, [0 1; 2 3])
    expect(1 - row, [0, -1, -2])
    expect(row - 1, [0 1 2])
    expect(1 - col, [0; -1; -2])
    expect(col - 1, [0; 1; 2])
    expect(2 + 3, 5)
    expect(2 - 3, -1)
    expect(2 * 3, 6)

    sa = single(a)
    srow = single(row)
    scol = single(col)
    expect(single(2) * sa, single([2 4; 6 8]))
    expect(sa * single(2), single([2 4; 6 8]))
    expect(single(2) * srow, single([2 4 6]))
    expect(srow * single(2), single([2 4 6]))
    expect(single(2) * scol, single([2; 4; 6]))
    expect(scol * single(2), single([2; 4; 6]))
    expect(single(1) + sa, single([2 3; 4 5]))
    expect(sa + single(1), single([2 3; 4 5]))
    expect(single(1) + srow, single([2 3 4]))
    expect(srow + single(1), single([2 3 4]))
    expect(single(1) + scol, single([2; 3; 4]))
    expect(scol + single(1), single([2; 3; 4]))
    expect(single(1) - sa, single([0, -1; -2, -3]))
    expect(sa - single(1), single([0 1; 2 3]))
    expect(single(1) - srow, single([0, -1, -2]))
    expect(srow - single(1), single([0 1 2]))
    expect(single(1) - scol, single([0; -1; -2]))
    expect(scol - single(1), single([0; 1; 2]))

    ia = int32(a)
    irow = int32(row)
    icol = int32(col)
    expect(int32(2) * ia, [2 4; 6 8])
    expect(ia * int32(2), [2 4; 6 8])
    expect(int32(2) * irow, [2 4 6])
    expect(irow * int32(2), [2 4 6])
    expect(int32(2) * icol, [2; 4; 6])
    expect(icol * int32(2), [2; 4; 6])
    expect(int32(1) + ia, int32([2 3; 4 5]))
    expect(ia + int32(1), int32([2 3; 4 5]))
    expect(int32(1) + irow, int32([2 3 4]))
    expect(irow + int32(1), int32([2 3 4]))
    expect(int32(1) + icol, int32([2; 3; 4]))
    expect(icol + int32(1), int32([2; 3; 4]))
    expect(int32(1) - ia, int32([0, -1; -2, -3]))
    expect(ia - int32(1), int32([0 1; 2 3]))
    expect(int32(1) - irow, int32([0, -1, -2]))
    expect(irow - int32(1), int32([0 1 2]))
    expect(int32(1) - icol, int32([0; -1; -2]))
    expect(icol - int32(1), int32([0; 1; 2]))

    la = int64(a)
    lrow = int64(row)
    lcol = int64(col)
    expect(int64(2) * la, [2 4; 6 8])
    expect(la * int64(2), [2 4; 6 8])
    expect(int64(2) * lrow, [2 4 6])
    expect(lrow * int64(2), [2 4 6])
    expect(int64(2) * lcol, [2; 4; 6])
    expect(lcol * int64(2), [2; 4; 6])
    expect(int64(1) + la, int64([2 3; 4 5]))
    expect(la + int64(1), int64([2 3; 4 5]))
    expect(int64(1) + lrow, int64([2 3 4]))
    expect(lrow + int64(1), int64([2 3 4]))
    expect(int64(1) + lcol, int64([2; 3; 4]))
    expect(lcol + int64(1), int64([2; 3; 4]))
    expect(int64(1) - la, int64([0, -1; -2, -3]))
    expect(la - int64(1), int64([0 1; 2 3]))
    expect(int64(1) - lrow, int64([0, -1, -2]))
    expect(lrow - int64(1), int64([0 1 2]))
    expect(int64(1) - lcol, int64([0; -1; -2]))
    expect(lcol - int64(1), int64([0; 1; 2]))
  end

  test 'int32 addition'
    expect(int32(3) + int32(4), int32(7))
  end


% Indexing, logic, and control flow. Subscripts, the end keyword, elseif, elementwise logic, for, while, if, and a user function.

  test 'index else and power'
    a = [1 2; 3 4];
    expect(a(1, 2), 2)
    expect(a(2, :), [3 4])
    expect(a(end, 1), 3)
    expect(a .^ 2, [1 4; 9 16])
    flag = 0;
    if 0
      flag = 1
    elseif 1
      flag = 2
    else
      flag = 3
    end
    expect(flag, 2)
    expect(~0, 1)
    expect([1 0] & [1 1], [1 0])
    expect([0 1] | [0 0], [0 1])
  end

  test 'control flow'
    total = int32(0)
    for k = 1:4
      total = total + int32(k)
    end
    expect(total, int32(10))
    n = 0
    while n < 3
      n = n + 1
    end
    expect(n, 3)
    flag = 0
    if ones(1, 'single')
      flag = 1
    end
    expect(flag, 1)
    if zeros(1, 'int64')
      flag = 0
    end
    expect(flag, 1)
    function y = addtwo(x)
      y = x + x
    end
    expect(addtwo(2.5), 5)
    expect(addtwo(single(1.5)), single(3))
    expect(addtwo(int32(4)), int32(8))
    expect(addtwo(int64(5)), int64(10))
  end

  test 'user function'
    function y = twice(x)
      y = x + x
    end
    expect(twice(3), 6)
  end


% Elementwise math. abs, sign, sqrt, exp, log, log2, log10, sin, cos, tan, asin, acos, atan, atan2, sinh, cosh, tanh, floor, ceil, round, fix, mod, rem, power, plus, minus, times, and rdivide. Each command is tried for double, single, int32, and int64, and for a scalar, a row, a column, and a matrix.

  test 'abs'
    expect(abs(-2), 2)
    expect(abs([-2 0 3]), [2 0 3])
    expect(abs([-2; 0; 3]), [2; 0; 3])
    expect(abs([-2 0; 3 4]), [2 0; 3 4])
    expect(abs(single(-2)), 2)
    expect(abs(single([-2 0 3])), [2 0 3])
    expect(abs(single([-2; 0; 3])), [2; 0; 3])
    expect(abs(single([-2 0; 3 4])), [2 0; 3 4])
    expect(abs(int32(-2)), int32(2))
    expect(abs(int32([-2 0 3])), int32([2 0 3]))
    expect(abs(int32([-2; 0; 3])), int32([2; 0; 3]))
    expect(abs(int32([-2 0; 3 4])), int32([2 0; 3 4]))
    expect(abs(int64(-2)), int64(2))
    expect(abs(int64([-2 0 3])), int64([2 0 3]))
    expect(abs(int64([-2; 0; 3])), int64([2; 0; 3]))
    expect(abs(int64([-2 0; 3 4])), int64([2 0; 3 4]))
  end

  test 'sign'
    expect(sign([-2 0 3]), [-1 0 1])
    expect(sign([-2; 0; 3]), [-1; 0; 1])
    expect(sign(0), 0)
    expect(sign([-2 0; 3, -4]), [-1 0; 1, -1])
    expect(sign(single([-2 0 3])), single([-1 0 1]))
    expect(sign(single([-2; 0; 3])), single([-1; 0; 1]))
    expect(sign(single(0)), single(0))
    expect(sign(single([-2 0; 3, -4])), single([-1 0; 1, -1]))
    expect(sign(int32([-2 0 3])), int32([-1 0 1]))
    expect(sign(int32([-2; 0; 3])), int32([-1; 0; 1]))
    expect(sign(int32(0)), int32(0))
    expect(sign(int32([-2 0; 3, -4])), int32([-1 0; 1, -1]))
    expect(sign(int64([-2 0 3])), int64([-1 0 1]))
    expect(sign(int64([-2; 0; 3])), int64([-1; 0; 1]))
    expect(sign(int64(0)), int64(0))
    expect(sign(int64([-2 0; 3, -4])), int64([-1 0; 1, -1]))
  end

  test 'sqrt'
    expect(sqrt(4), 2)
    expect(sqrt([4 9 16]), [2 3 4])
    expect(sqrt([4; 9; 16]), [2; 3; 4])
    expect(sqrt([4 9; 16 25]), [2 3; 4 5])
    expect(sqrt(single(4)), 2)
    expect(sqrt(single([4 9 16])), [2 3 4])
    expect(sqrt(single([4; 9; 16])), [2; 3; 4])
    expect(sqrt(single([4 9; 16 25])), [2 3; 4 5])
    expect(sqrt(int32(4)), 2)
    expect(sqrt(int32([4 9 16])), [2 3 4])
    expect(sqrt(int32([4; 9; 16])), [2; 3; 4])
    expect(sqrt(int32([4 9; 16 25])), [2 3; 4 5])
    expect(sqrt(int64(4)), 2)
    expect(sqrt(int64([4 9 16])), [2 3 4])
    expect(sqrt(int64([4; 9; 16])), [2; 3; 4])
    expect(sqrt(int64([4 9; 16 25])), [2 3; 4 5])
  end

  test 'exp'
    expect(exp(0), 1)
    expect(exp([0 0 0]), [1 1 1])
    expect(exp([0; 0; 0]), [1; 1; 1])
    expect(exp(zeros(2)), ones(2))
    expect(exp(single(0)), single(1))
    expect(exp(single([0 0 0])), single([1 1 1]))
    expect(exp(single([0; 0; 0])), single([1; 1; 1]))
    expect(exp(zeros(2, 'single')), ones(2, 'single'))
    expect(exp(int32(0)), 1)
    expect(exp(int32([0 0 0])), [1 1 1])
    expect(exp(int32([0; 0; 0])), [1; 1; 1])
    expect(exp(zeros(2, 'int32')), ones(2))
    expect(exp(int64(0)), 1)
    expect(exp(int64([0 0 0])), [1 1 1])
    expect(exp(int64([0; 0; 0])), [1; 1; 1])
    expect(exp(zeros(2, 'int64')), ones(2))
  end

  test 'log'
    expect(log(1), 0)
    expect(log([1 1 1]), [0 0 0])
    expect(log([1; 1; 1]), [0; 0; 0])
    expect(log(ones(2)), zeros(2))
    expect(log(single(1)), single(0))
    expect(log(single([1 1 1])), single([0 0 0]))
    expect(log(single([1; 1; 1])), single([0; 0; 0]))
    expect(log(ones(2, 'single')), zeros(2, 'single'))
    expect(log(int32(1)), 0)
    expect(log(int32([1 1 1])), [0 0 0])
    expect(log(int32([1; 1; 1])), [0; 0; 0])
    expect(log(ones(2, 'int32')), zeros(2))
    expect(log(int64(1)), 0)
    expect(log(int64([1 1 1])), [0 0 0])
    expect(log(int64([1; 1; 1])), [0; 0; 0])
    expect(log(ones(2, 'int64')), zeros(2))
  end

  test 'log2'
    expect(log2(1), 0)
    expect(log2([1 1 1]), [0 0 0])
    expect(log2([1; 1; 1]), [0; 0; 0])
    expect(log2(ones(2)), zeros(2))
    expect(log2(single(1)), single(0))
    expect(log2(single([1 1 1])), single([0 0 0]))
    expect(log2(single([1; 1; 1])), single([0; 0; 0]))
    expect(log2(ones(2, 'single')), zeros(2, 'single'))
    expect(log2(int32(1)), 0)
    expect(log2(ones(1, 3, 'int32')), zeros(1, 3))
    expect(log2(ones(3, 1, 'int32')), zeros(3, 1))
    expect(log2(ones(2, 'int32')), zeros(2))
    expect(log2(int64(1)), 0)
    expect(log2(ones(1, 3, 'int64')), zeros(1, 3))
    expect(log2(ones(3, 1, 'int64')), zeros(3, 1))
    expect(log2(ones(2, 'int64')), zeros(2))
  end

  test 'log10'
    expect(log10(1), 0)
    expect(log10([1 1 1]), [0 0 0])
    expect(log10([1; 1; 1]), [0; 0; 0])
    expect(log10(ones(2)), zeros(2))
    expect(log10(single(1)), single(0))
    expect(log10(single([1 1 1])), single([0 0 0]))
    expect(log10(single([1; 1; 1])), single([0; 0; 0]))
    expect(log10(ones(2, 'single')), zeros(2, 'single'))
    expect(log10(int32(1)), 0)
    expect(log10(ones(1, 3, 'int32')), zeros(1, 3))
    expect(log10(ones(3, 1, 'int32')), zeros(3, 1))
    expect(log10(ones(2, 'int32')), zeros(2))
    expect(log10(int64(1)), 0)
    expect(log10(ones(1, 3, 'int64')), zeros(1, 3))
    expect(log10(ones(3, 1, 'int64')), zeros(3, 1))
    expect(log10(ones(2, 'int64')), zeros(2))
  end

  test 'sin'
    expect(sin(0), 0)
    expect(sin([0 0 0]), [0 0 0])
    expect(sin([0; 0; 0]), [0; 0; 0])
    expect(sin(zeros(2)), zeros(2))
    expect(sin(single(0)), single(0))
    expect(sin(zeros(1, 3, 'single')), zeros(1, 3, 'single'))
    expect(sin(zeros(3, 1, 'single')), zeros(3, 1, 'single'))
    expect(sin(zeros(2, 'single')), zeros(2, 'single'))
    expect(sin(int32(0)), 0)
    expect(sin(zeros(1, 3, 'int32')), zeros(1, 3))
    expect(sin(zeros(3, 1, 'int32')), zeros(3, 1))
    expect(sin(zeros(2, 'int32')), zeros(2))
    expect(sin(int64(0)), 0)
    expect(sin(zeros(1, 3, 'int64')), zeros(1, 3))
    expect(sin(zeros(3, 1, 'int64')), zeros(3, 1))
    expect(sin(zeros(2, 'int64')), zeros(2))
  end

  test 'cos'
    expect(cos(0), 1)
    expect(cos([0 0 0]), [1 1 1])
    expect(cos([0; 0; 0]), [1; 1; 1])
    expect(cos(zeros(2)), ones(2))
    expect(cos(single(0)), single(1))
    expect(cos(zeros(1, 3, 'single')), ones(1, 3, 'single'))
    expect(cos(zeros(3, 1, 'single')), ones(3, 1, 'single'))
    expect(cos(zeros(2, 'single')), ones(2, 'single'))
    expect(cos(int32(0)), 1)
    expect(cos(zeros(1, 3, 'int32')), ones(1, 3))
    expect(cos(zeros(3, 1, 'int32')), ones(3, 1))
    expect(cos(zeros(2, 'int32')), ones(2))
    expect(cos(int64(0)), 1)
    expect(cos(zeros(1, 3, 'int64')), ones(1, 3))
    expect(cos(zeros(3, 1, 'int64')), ones(3, 1))
    expect(cos(zeros(2, 'int64')), ones(2))
  end

  test 'tan'
    expect(tan(0), 0)
    expect(tan([0 0 0]), [0 0 0])
    expect(tan([0; 0; 0]), [0; 0; 0])
    expect(tan(zeros(2)), zeros(2))
    expect(tan(single(0)), single(0))
    expect(tan(zeros(1, 3, 'single')), zeros(1, 3, 'single'))
    expect(tan(zeros(3, 1, 'single')), zeros(3, 1, 'single'))
    expect(tan(zeros(2, 'single')), zeros(2, 'single'))
    expect(tan(int32(0)), 0)
    expect(tan(zeros(1, 3, 'int32')), zeros(1, 3))
    expect(tan(zeros(3, 1, 'int32')), zeros(3, 1))
    expect(tan(zeros(2, 'int32')), zeros(2))
    expect(tan(int64(0)), 0)
    expect(tan(zeros(1, 3, 'int64')), zeros(1, 3))
    expect(tan(zeros(3, 1, 'int64')), zeros(3, 1))
    expect(tan(zeros(2, 'int64')), zeros(2))
  end

  test 'asin'
    expect(asin(0), 0)
    expect(asin([0 0 0]), [0 0 0])
    expect(asin([0; 0; 0]), [0; 0; 0])
    expect(asin(zeros(2)), zeros(2))
    expect(asin(single(0)), single(0))
    expect(asin(zeros(1, 3, 'single')), zeros(1, 3, 'single'))
    expect(asin(zeros(3, 1, 'single')), zeros(3, 1, 'single'))
    expect(asin(zeros(2, 'single')), zeros(2, 'single'))
    expect(asin(int32(0)), 0)
    expect(asin(zeros(1, 3, 'int32')), zeros(1, 3))
    expect(asin(zeros(3, 1, 'int32')), zeros(3, 1))
    expect(asin(zeros(2, 'int32')), zeros(2))
    expect(asin(int64(0)), 0)
    expect(asin(zeros(1, 3, 'int64')), zeros(1, 3))
    expect(asin(zeros(3, 1, 'int64')), zeros(3, 1))
    expect(asin(zeros(2, 'int64')), zeros(2))
  end

  test 'acos'
    expect(acos(1), 0)
    expect(acos([1 1 1]), [0 0 0])
    expect(acos([1; 1; 1]), [0; 0; 0])
    expect(acos(ones(2)), zeros(2))
    expect(acos(single(1)), single(0))
    expect(acos(ones(1, 3, 'single')), zeros(1, 3, 'single'))
    expect(acos(ones(3, 1, 'single')), zeros(3, 1, 'single'))
    expect(acos(ones(2, 'single')), zeros(2, 'single'))
    expect(acos(int32(1)), 0)
    expect(acos(ones(1, 3, 'int32')), zeros(1, 3))
    expect(acos(ones(3, 1, 'int32')), zeros(3, 1))
    expect(acos(ones(2, 'int32')), zeros(2))
    expect(acos(int64(1)), 0)
    expect(acos(ones(1, 3, 'int64')), zeros(1, 3))
    expect(acos(ones(3, 1, 'int64')), zeros(3, 1))
    expect(acos(ones(2, 'int64')), zeros(2))
  end

  test 'atan'
    expect(atan(0), 0)
    expect(atan([0 0 0]), [0 0 0])
    expect(atan([0; 0; 0]), [0; 0; 0])
    expect(atan(zeros(2)), zeros(2))
    expect(atan(single(0)), single(0))
    expect(atan(zeros(1, 3, 'single')), zeros(1, 3, 'single'))
    expect(atan(zeros(3, 1, 'single')), zeros(3, 1, 'single'))
    expect(atan(zeros(2, 'single')), zeros(2, 'single'))
    expect(atan(int32(0)), 0)
    expect(atan(zeros(1, 3, 'int32')), zeros(1, 3))
    expect(atan(zeros(3, 1, 'int32')), zeros(3, 1))
    expect(atan(zeros(2, 'int32')), zeros(2))
    expect(atan(int64(0)), 0)
    expect(atan(zeros(1, 3, 'int64')), zeros(1, 3))
    expect(atan(zeros(3, 1, 'int64')), zeros(3, 1))
    expect(atan(zeros(2, 'int64')), zeros(2))
  end

  test 'atan2'
    expect(atan2(0, 1), 0)
    expect(atan2([0 0 0], 1), [0 0 0])
    expect(atan2([0; 0; 0], 1), [0; 0; 0])
    expect(atan2(zeros(2), 1), zeros(2))
    expect(atan2(single(0), single(1)), single(0))
    expect(atan2(zeros(1, 3, 'single'), single(1)), zeros(1, 3, 'single'))
    expect(atan2(zeros(3, 1, 'single'), single(1)), zeros(3, 1, 'single'))
    expect(atan2(zeros(2, 'single'), single(1)), zeros(2, 'single'))
    expect(atan2(int32(0), int32(1)), 0)
    expect(atan2(zeros(1, 3, 'int32'), int32(1)), zeros(1, 3))
    expect(atan2(zeros(3, 1, 'int32'), int32(1)), zeros(3, 1))
    expect(atan2(zeros(2, 'int32'), int32(1)), zeros(2))
    expect(atan2(int64(0), int64(1)), 0)
    expect(atan2(zeros(1, 3, 'int64'), int64(1)), zeros(1, 3))
    expect(atan2(zeros(3, 1, 'int64'), int64(1)), zeros(3, 1))
    expect(atan2(zeros(2, 'int64'), int64(1)), zeros(2))
  end

  test 'sinh'
    expect(sinh(0), 0)
    expect(sinh([0 0 0]), [0 0 0])
    expect(sinh([0; 0; 0]), [0; 0; 0])
